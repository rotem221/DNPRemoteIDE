# Xcode
build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/

# Generated Xcode projects (re-generated by xcodegen)
apps/DNPRemoteMac/DNPRemoteMac.xcodeproj/
apps/DNPRemoteiOS/DNPRemoteiOS.xcodeproj/

# macOS
.DS_Store

# DNP runtime artifacts. Per-project memory is auto-maintained at
# runtime by DNP Remote Mac; treating the whole `memory/` tree as
# generated keeps experimental notebooks, crash dumps, and session
# transcripts out of the repo entirely.
.dnp/events/
memory/

# Per-developer Xcode signing override. Each contributor creates
# their own `apps/<App>/Local.xcconfig` from `Local.sample.xcconfig`
# with their Apple `DEVELOPMENT_TEAM` so personal team identifiers
# never land in source control.
apps/*/Local.xcconfig

# Sparkle private key dumped by `scripts/generate-sparkle-key.swift`
# to the operator's home dir. Never commit.
.dnp-sparkle-private-key

# Local-only Claude settings (never commit)
.claude/settings.local.json

# Build output
*.ipa
*.app

# Logs
*.log

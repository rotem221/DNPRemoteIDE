{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "DNP Remote Suite — safe defaults. Hook relay never blocks Claude Code execution; failures fall back to .dnp/events/hooks.jsonl.",
  "hooks": {
    "SessionStart": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event SessionStart" }] }
    ],
    "UserPromptSubmit": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event UserPromptSubmit" }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event PreToolUse" }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event PostToolUse" }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event PermissionRequest" }] }
    ],
    "Notification": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event Notification" }] }
    ],
    "PreCompact": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event PreCompact" }] }
    ],
    "SessionEnd": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event SessionEnd" }] }
    ],
    "Stop": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event Stop" }] }
    ],
    "SubagentStop": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "./tools/dnp-hook-relay/dnp-hook-relay --event SubagentStop" }] }
    ]
  }
}
